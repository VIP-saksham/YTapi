[TEMPLATE]
# ============================================================
# .env.example — Copy to .env and fill in your values
# ============================================================

# ── Server ───────────────────────────────────────────────────
APP_NAME=HellAPI
PORT=8000
APP_URL=http://YOUR_VPS_IP:8000
API_BASE_URL=http://localhost:8000
ADMIN_KEY=your_strong_admin_password
# Song-name search is off by default; URL/ID-only avoids extra upstream hits.
ALLOW_SEARCH=false

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
BOT_NAME=HellAPI
ADMIN_IDS=your_telegram_id
SUPPORT_GROUP=https://t.me/yoursupport
CHANNEL=https://t.me/yourchannel
BOT_URL=

# ── Payment ──────────────────────────────────────────────────
UPI_ID=yourname@upi
UPI_NAME=HellAPI
BANK_NAME=
BANK_ACCOUNT=
BANK_IFSC=

# ── Free anti-block stack ───────────────────────────────
# OPTIONAL: cookies lagao to account-limit (2000/hr) milta hai. Bina cookies
# bhi chalta hai — guest session (250/hr budget, niche YTDLP_HOURLY_LIMIT).
# Export tarika (yt-dlp wiki ka official tarika):
#   1. Incognito window kholo → youtube.com pe login karo
#   2. https://www.youtube.com/robots.txt kholo usi tab me
#   3. Browser extension se youtube.com cookies export karo → cookies.txt
#   4. File project folder me rakho aur path niche do
YTDLP_COOKIE_FILE=
# Video ki visitor data (cookies ke bina personalized Innertube requests ke liye)
YTDLP_VISITOR_DATA=
# Guest session limit ~300 videos/hour hota hai — iske neeche raho (sliding window)
YTDLP_HOURLY_LIMIT=250
# Cookies kitne din purani hui to admin status me warning:
YTDLP_COOKIE_STALE_DAYS=14
# PO token (optional — mweb client ke sath kaam karta hai)
YTDLP_PO_TOKEN=
# JS runtime for yt-dlp (deno/node) — naye YouTube JS challenges ke liye.
# VPS pe deno default hai (vps_setup.sh install karta hai). Node bhi chalega.
YTDLP_JS_RUNTIME=deno

# ── OAuth2 login (IP-block se bachne ka sabse strong tarika) ─────
# 1 = yt-dlp YouTube ko logged-in session se hit karega (device-flow token).
# Pehli baar login:  python oauth_setup.py  → google.com/device pe code daalo.
# Token auto-refresh hota hai. Guest 250/hr limit nahi lagti — ~2000/hr milti hai.
YTDLP_OAUTH=0

# ── Speed & cache tuning ────────────────────────────────────
# Stream URL cache cap (googlevideo URL ~6h valid; apni expiry tak cache,
# repeat request instant). Cap minutes me:
YTDLP_STREAM_TTL_CAP_MIN=300
# Deleted/private videos kitni der instant-fail rahein (YT hit bache):
YTDLP_NEG_TTL_SEC=600
# RAM metadata cache (8 min TTL default):
YTDLP_CACHE_TTL=480
YTDLP_CACHE_SIZE=256
# Parallel yt-dlp workers:
YTDLP_WORKERS=4

# ── Proxy (optional — cookies + budget akele bhi kaafi hain) ─
# Format: http://user:pass@ip:port
# Multiple: http://u:p@ip1:port,http://u:p@ip2:port
# Blocked proxy ka cooldown (exponential backoff hota hai: 60→120→240s...)
PROXY_FAIL_COOLDOWN_SEC=60
YTDLP_MAX_RETRIES=2

# ── Circuit breaker (server-IP protection) ───────────────────
# Consecutive YouTube blocks itne hone pe fail-fast + Retry-After:
YT_CB_THRESHOLD=3
YT_CB_COOLDOWN_SEC=120

# ── yt-dlp auto-update + auto-restart ───────────────────────
# Har interval par pip se latest yt-dlp (YouTube changes ka fastest fix):
YTDLP_AUTO_UPDATE=1
YTDLP_UPDATE_INTERVAL=3600
# Khaali = latest. Specific version pe pin karna ho to:
YTDLP_PIN_VERSION=
# Bar-bar IP-block hone par services auto-restart (fresh connections + IP state):
YT_AUTO_RESTART_ON_BLOCK=1
YT_RESTART_BLOCK_THRESHOLD=2
YT_RESTART_COOLDOWN_SEC=900
# Custom restart command (default: systemctl restart hellapi-api hellapi-bot)
YT_UPDATE_RESTART_CMD=

# ── Security ─────────────────────────────────────────────────
BF_MAX_ATTEMPTS=10
BF_WINDOW_SEC=60
BF_BLOCK_SEC=300

# ── DB Cache ─────────────────────────────────────────────────
VIDEO_CACHE_TTL_DAYS=7
# Search results DB me kitne ghante (same query = DB se):
SEARCH_CACHE_TTL_HOURS=24

# ── Telegram DB channel (VPS-death-proof cache) ──────────────
# Private channel banao, @bot ko admin banao, phir chalao:
#   ./venv/bin/python db_channel_setup.py
# Ye ID auto-save kar dega. Khali = feature off (sab pehle jaisa chalega).
DB_CHANNEL_ID=
