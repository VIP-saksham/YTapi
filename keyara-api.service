[Unit]
Description=KeyaraAPI — Self-hosted YouTube Extraction API (VIP-saksham/api)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/nakshu/keyaraapi
Environment=PATH=/root/.deno/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_CONFIG_HOME=/root/.config
ExecStart=/root/nakshu/keyaraapi/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:/root/nakshu/keyaraapi/service.log
StandardError=append:/root/nakshu/keyaraapi/service.log

[Install]
WantedBy=multi-user.target
